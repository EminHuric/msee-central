rules_version = '2';

/*
 * MsEe Central — Firestore Security Rules
 *
 * THIS FILE IS THE SECURITY BOUNDARY. Everything in src/ that checks a
 * permission does so for the user's convenience: to hide a button, to skip a
 * doomed request. None of it stops anybody. A person with a browser console
 * talks to Firestore directly, and these rules are what answers them.
 *
 * Two habits keep this file trustworthy:
 *
 *   1. Deny by default. Firestore already refuses anything not matched below;
 *      never add a broad `match /{document=**}` to "make it work".
 *   2. Never trust a field the client sent. `request.resource.data` is
 *      attacker-controlled. Compare it against `resource.data` (what is
 *      already stored) or against the caller's own permission document.
 *
 * The tests in tests/rules prove the important claims. Run them after every
 * change to this file:  npm run rules:test
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Identity helpers
     * ------------------------------------------------------------------ */

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /*
     * userPermissions/{uid} is the single source of truth for authority.
     * Its ABSENCE is meaningful: an account that has registered but has not
     * been approved has no such document, and therefore no access at all.
     */
    function accessPath() {
      return /databases/$(database)/documents/userPermissions/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    /* Suspended, deactivated and rejected accounts fail here and read nothing. */
    function isActive() {
      return hasAccess() && access().status == 'active';
    }

    /*
     * An OWNER: CEO or CTO. Both carry a role marked grantsAll and are equal in
     * every power the system has.
     *
     * The stored field is still called isCeo because that is what exists in the
     * database; read it as "owner". Owner status is what opens the private
     * privacy tier, CEO notes and the ability to appoint another owner.
     *
     * The safety rail that makes two owners meaningful: nobody may remove their
     * own owner role, so an owner can only ever be removed by the other one.
     */
    function isOwner() {
      return isActive() && access().isCeo == true;
    }

    /*
     * The FOUNDER — the person who owns the company.
     *
     * One account, marked once by tools/setup-ceo.mjs and never grantable from
     * inside the application: every rule below refuses to write the flag, so
     * it cannot be forged or handed around.
     *
     * It buys two things nothing else can:
     *   - the founder's account cannot be altered by anybody, owner or not;
     *   - only the founder may appoint or remove a co-owner.
     *
     * `.get('isFounder', false)` rather than a plain field read, so documents
     * written before this flag existed evaluate to false instead of erroring.
     */
    function isFounder() {
      return isActive() && access().get('isFounder', false) == true;
    }

    /** Is the document being written the founder's own? */
    function targetIsFounder() {
      return resource != null && resource.data.get('isFounder', false) == true;
    }

    /**
     * Same question asked about a person rather than a document, for rules
     * outside the userPermissions collection.
     */
    function personIsFounder(uid) {
      return exists(/databases/$(database)/documents/userPermissions/$(uid))
        && get(/databases/$(database)/documents/userPermissions/$(uid))
             .data.get('isFounder', false) == true;
    }

    /*
     * The CEO role carries grantsAll, so it answers true for permissions that
     * do not exist yet. Future modules are covered without touching this file.
     */
    function can(permission) {
      return isActive() && (access().isCeo == true || permission in access().permissions);
    }

    /* Only these keys differ between the stored document and the incoming one. */
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    /* ------------------------------------------------------------------ *
     * userPermissions — the crown jewel
     *
     * Three tiers of authority, and each is protected from the one below it:
     *
     *   founder   the company owner. Untouchable by anyone. Only they may
     *             appoint or remove a co-owner.
     *   owner     CEO or a co-owner. Full authority over everybody except the
     *             founder, and cannot create another owner.
     *   manager   holds roles.assign. May configure ordinary employees, and
     *             may never write their OWN document — that is what stops an
     *             employee promoting themselves.
     *
     * The founder document is created by tools/setup-ceo.mjs through the Admin
     * SDK, which bypasses these rules. That is deliberate: there is no
     * bootstrap path here for anyone to climb through, and equally no recovery
     * path if the founder account is lost. The service account key is the only
     * way back, which is why it matters as much as the password.
     * ------------------------------------------------------------------ */

    match /userPermissions/{uid} {
      allow read: if isSelf(uid) || can('roles.assign');

      allow create: if request.resource.data.uid == uid
        && can('roles.assign')
        && !isSelf(uid)
        /* The founder mark is never granted from inside the application. */
        && request.resource.data.get('isFounder', false) == false
        /* Only the founder may appoint a co-owner. */
        && (request.resource.data.isCeo == false || isFounder());

      allow update: if request.resource.data.uid == uid
        && (
          /*
           * Someone else's document.
           *
           * Three separate refusals here, and each closes a different door:
           * a manager cannot touch their own; nobody at all can touch the
           * founder's; and only the founder can hand out owner status.
           */
          (
            can('roles.assign')
            && !isSelf(uid)
            && !targetIsFounder()
            && request.resource.data.get('isFounder', false) == false
            && (request.resource.data.isCeo == false || isFounder())
          )
          /*
           * An owner editing their own document. Allowed because an owner
           * already holds every permission — there is nothing here to escalate
           * to — and scoped to isOwner() so the branch above keeps protecting
           * everyone below.
           *
           * The three conditions stop an owner locking themselves out: they
           * cannot drop their own owner status, cannot set themselves to
           * anything but active, and cannot change their founder mark in
           * either direction.
           */
          || (
            isOwner()
            && isSelf(uid)
            && request.resource.data.isCeo == true
            && request.resource.data.status == 'active'
            && request.resource.data.get('isFounder', false)
               == resource.data.get('isFounder', false)
          )
        );

      /* Access is revoked by setting status, never by deleting history. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * registrationRequests
     *
     * Written once by the applicant, thereafter only by a reviewer. The
     * applicant cannot approve themselves because they cannot update at all.
     * ------------------------------------------------------------------ */

    match /registrationRequests/{uid} {
      allow read: if isSelf(uid) || can('registration_requests.view');

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.email == request.auth.token.email;

      allow update: if (can('registration_requests.approve') || can('registration_requests.reject'))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.submittedAt == resource.data.submittedAt;

      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * employees/{uid} — professional identity
     *
     * Per the specification an employee cannot hide these from coworkers:
     * they describe the job, not the person. What an employee may edit about
     * themselves is limited to the presentational fields listed below —
     * never their role, status, department or position.
     * ------------------------------------------------------------------ */

    match /employees/{uid} {
      allow read: if isSelf(uid) || can('employees.view');

      allow create: if can('registration_requests.approve')
        && request.resource.data.uid == uid;

      /*
       * Four distinct ways this document may change, and no others.
       *
       * The founder guard sits at the TOP rather than inside each branch. It
       * was written per-branch first and one path slipped through — a rule
       * that has to be remembered in four places will eventually be forgotten
       * in one. Stated once, it covers every branch here and every branch
       * added later.
       *
       * Note also the second branch: holding edit_professional is NOT enough
       * to change status or roleIds. Editing somebody's job title must never
       * double as a way to change who they are or what they may do.
       */
      allow update: if request.resource.data.uid == resource.data.uid
        /* The founder's record is theirs alone to change. */
        && (isSelf(uid) || !personIsFounder(uid))
        && (
          (
            isSelf(uid)
            && isActive()
            && changedOnly(['photoUrl', 'bio', 'skills', 'expertise', 'updatedAt'])
          )
          || (
            can('employees.edit_professional')
            && (
              request.resource.data.status == resource.data.status
              || can('employees.manage_status')
            )
            && (
              request.resource.data.roleIds == resource.data.roleIds
              || can('roles.assign')
            )
          )
          || (can('employees.manage_status') && changedOnly(['status', 'updatedAt']))
          || (can('roles.assign') && changedOnly(['roleIds', 'updatedAt']))
        );

      /* Historical employee records are preserved, never deleted. */
      allow delete: if false;

      /* ---------------------------------------------------------------- *
       * Privacy tiers.
       *
       * Firestore guards a document, never a field — so the three visibility
       * levels are three documents. Moving a field between them IS the
       * privacy setting. A mistake in one tier cannot leak the others.
       * ---------------------------------------------------------------- */

      match /visibility/everyone {
        allow read: if isSelf(uid) || can('employees.view');
        allow write: if isSelf(uid) || isOwner();
      }

      match /visibility/management {
        allow read: if isSelf(uid) || can('employees.view_private_info');
        allow write: if isSelf(uid) || isOwner();
      }

      /*
       * The CEO is included because company administration must never be
       * blocked by an employee's privacy choices. No other permission opens
       * this tier.
       */
      match /visibility/private {
        allow read: if isSelf(uid) || isOwner();
        allow write: if isSelf(uid) || isOwner();
      }

      /* ---------------------------------------------------------------- *
       * CEO notes — never readable by their subject.
       *
       * The !isSelf(uid) clause matters: a manager who holds
       * employee_notes.view must still not read what is written about them.
       * ---------------------------------------------------------------- */

      match /notes/{noteId} {
        allow read: if isOwner() || (can('employee_notes.view') && !isSelf(uid));

        allow create: if can('employee_notes.create')
          && !isSelf(uid)
          && request.resource.data.authorUid == me()
          && request.resource.data.employeeUid == uid;

        allow update: if can('employee_notes.edit')
          && !isSelf(uid)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.employeeUid == resource.data.employeeUid
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if can('employee_notes.delete') && !isSelf(uid);
      }
    }

    /* ------------------------------------------------------------------ *
     * Roles, permission catalogue, departments, positions
     *
     * Readable by any active employee: the directory has to render a role
     * name next to a person. Only the permission list inside a role carries
     * weight, and changing it is gated below.
     * ------------------------------------------------------------------ */

    match /roles/{roleId} {
      allow read: if isActive();

      allow create: if can('roles.create')
        && (request.resource.data.grantsAll == false || isOwner())
        && request.resource.data.isSystem == false;

      allow update: if can('roles.edit')
        && request.resource.data.key == resource.data.key
        && request.resource.data.isSystem == resource.data.isSystem
        && (request.resource.data.grantsAll == resource.data.grantsAll || isOwner())
        && (
          resource.data.isSystem == false
          || changedOnly(['name', 'nameSr', 'description', 'descriptionSr', 'updatedAt'])
        );

      /* Roles are deactivated, never deleted — deleting destroys history. */
      allow delete: if false;
    }

    match /permissions/{key} {
      allow read: if isActive();
      allow write: if false;
    }

    match /departments/{id} {
      allow read: if isActive();
      allow write: if can('departments.manage');
    }

    match /positions/{id} {
      allow read: if isActive();
      allow write: if can('positions.manage');
    }

    /* ------------------------------------------------------------------ *
     * auditLogs — append only
     *
     * Entries may be created by any active account but never altered or
     * removed by anyone, and the actor cannot be forged.
     *
     * KNOWN LIMIT: because the client writes these, the rules can reject a
     * forged or tampered entry but cannot force an entry to be written at
     * all. Someone working directly against the API could perform an action
     * and skip logging it. Closing that gap requires Cloud Functions (Blaze
     * plan), which is the intended upgrade path. Everything done through the
     * application itself is logged.
     * ------------------------------------------------------------------ */

    match /auditLogs/{entryId} {
      allow read: if can('audit_log.view');

      allow create: if isActive()
        && request.resource.data.actorUid == me()
        && request.resource.data.actorEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Company settings
     * ------------------------------------------------------------------ */

    match /companySettings/{key} {
      allow read: if isActive();
      allow write: if can('company_settings.edit');
    }

    /* ------------------------------------------------------------------ *
     * Prepared for StayBrain. Unused in version 1 and locked to the CEO, so
     * an unfinished feature cannot become an opening.
     * ------------------------------------------------------------------ */

    match /externalReferences/{id} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    /*
     * Everything else is denied. Firestore refuses anything not matched
     * above — do not add a catch-all rule here.
     */
  }
}
