rules_version = '2';

/*
 * MsEe Central — Firestore Security Rules
 *
 * THIS FILE IS THE SECURITY BOUNDARY. Everything in src/ that checks a
 * permission does so for the user's convenience: to hide a button, to skip a
 * doomed request. None of it stops anybody. A person with a browser console
 * talks to Firestore directly, and these rules are what answers them.
 *
 * Two habits keep this file trustworthy:
 *
 *   1. Deny by default. Firestore already refuses anything not matched below;
 *      never add a broad `match /{document=**}` to "make it work".
 *   2. Never trust a field the client sent. `request.resource.data` is
 *      attacker-controlled. Compare it against `resource.data` (what is
 *      already stored) or against the caller's own permission document.
 *
 * The tests in tests/rules prove the important claims. Run them after every
 * change to this file:  npm run rules:test
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Identity helpers
     * ------------------------------------------------------------------ */

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /*
     * userPermissions/{uid} is the single source of truth for authority.
     * Its ABSENCE is meaningful: an account that has registered but has not
     * been approved has no such document, and therefore no access at all.
     */
    function accessPath() {
      return /databases/$(database)/documents/userPermissions/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    /* Suspended, deactivated and rejected accounts fail here and read nothing. */
    function isActive() {
      return hasAccess() && access().status == 'active';
    }

    /*
     * An OWNER: CEO or CTO. Both carry a role marked grantsAll and are equal in
     * every power the system has.
     *
     * The stored field is still called isCeo because that is what exists in the
     * database; read it as "owner". Owner status is what opens the private
     * privacy tier, CEO notes and the ability to appoint another owner.
     *
     * The safety rail that makes two owners meaningful: nobody may remove their
     * own owner role, so an owner can only ever be removed by the other one.
     */
    function isOwner() {
      return isActive() && access().isCeo == true;
    }

    /*
     * The FOUNDER — the person who owns the company.
     *
     * One account, marked once by tools/setup-ceo.mjs and never grantable from
     * inside the application: every rule below refuses to write the flag, so
     * it cannot be forged or handed around.
     *
     * It buys two things nothing else can:
     *   - the founder's account cannot be altered by anybody, owner or not;
     *   - only the founder may appoint or remove a co-owner.
     *
     * `.get('isFounder', false)` rather than a plain field read, so documents
     * written before this flag existed evaluate to false instead of erroring.
     */
    function isFounder() {
      return isActive() && access().get('isFounder', false) == true;
    }

    /** Is the document being written the founder's own? */
    function targetIsFounder() {
      return resource != null && resource.data.get('isFounder', false) == true;
    }

    /**
     * Same question asked about a person rather than a document, for rules
     * outside the userPermissions collection.
     */
    function personIsFounder(uid) {
      return exists(/databases/$(database)/documents/userPermissions/$(uid))
        && get(/databases/$(database)/documents/userPermissions/$(uid))
             .data.get('isFounder', false) == true;
    }

    /*
     * An AFFILIATE — an outside partner, not staff.
     *
     * They bring business and earn commission. They hold a real account and a
     * real login, and none of that makes them part of the company: they see
     * their own figures and nothing else. No colleagues, no departments, no
     * roles catalogue, no company settings.
     *
     * Checked here rather than left to permissions, because a permission can
     * be granted by mistake and this line should not be crossable by mistake.
     * Every internal read below asks isInternal() first, so an affiliate
     * holding employees.view still sees nobody.
     *
     * Defaults to 'employee' so accounts written before this existed keep
     * working as staff.
     */
    function isAffiliate() {
      return isActive() && access().get('accountType', 'employee') == 'affiliate';
    }

    /** Inside the company: staff, whatever their role. */
    function isInternal() {
      return isActive() && !isAffiliate();
    }

    /*
     * The CEO role carries grantsAll, so it answers true for permissions that
     * do not exist yet. Future modules are covered without touching this file.
     */
    function can(permission) {
      return isActive() && (access().isCeo == true || permission in access().permissions);
    }

    /* Only these keys differ between the stored document and the incoming one. */
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    /* ------------------------------------------------------------------ *
     * userPermissions — the crown jewel
     *
     * Three tiers of authority, and each is protected from the one below it:
     *
     *   founder   the company owner. Untouchable by anyone. Only they may
     *             appoint or remove a co-owner.
     *   owner     CEO or a co-owner. Full authority over everybody except the
     *             founder, and cannot create another owner.
     *   manager   holds roles.assign. May configure ordinary employees, and
     *             may never write their OWN document — that is what stops an
     *             employee promoting themselves.
     *
     * The founder document is created by tools/setup-ceo.mjs through the Admin
     * SDK, which bypasses these rules. That is deliberate: there is no
     * bootstrap path here for anyone to climb through, and equally no recovery
     * path if the founder account is lost. The service account key is the only
     * way back, which is why it matters as much as the password.
     * ------------------------------------------------------------------ */

    match /userPermissions/{uid} {
      allow read: if isSelf(uid) || can('roles.assign');

      allow create: if request.resource.data.uid == uid
        && can('roles.assign')
        && !isSelf(uid)
        /* The founder mark is never granted from inside the application. */
        && request.resource.data.get('isFounder', false) == false
        /* Only the founder may appoint a co-owner. */
        && (request.resource.data.isCeo == false || isFounder());

      allow update: if request.resource.data.uid == uid
        && (
          /*
           * Someone else's document.
           *
           * Three separate refusals here, and each closes a different door:
           * a manager cannot touch their own; nobody at all can touch the
           * founder's; and only the founder can hand out owner status.
           */
          (
            can('roles.assign')
            && !isSelf(uid)
            && !targetIsFounder()
            && request.resource.data.get('isFounder', false) == false
            && (request.resource.data.isCeo == false || isFounder())
          )
          /*
           * An owner editing their own document. Allowed because an owner
           * already holds every permission — there is nothing here to escalate
           * to — and scoped to isOwner() so the branch above keeps protecting
           * everyone below.
           *
           * The three conditions stop an owner locking themselves out: they
           * cannot drop their own owner status, cannot set themselves to
           * anything but active, and cannot change their founder mark in
           * either direction.
           */
          || (
            isOwner()
            && isSelf(uid)
            && request.resource.data.isCeo == true
            && request.resource.data.status == 'active'
            && request.resource.data.get('isFounder', false)
               == resource.data.get('isFounder', false)
          )
        );

      /*
       * Access is revoked by setting status, never by deleting. The one
       * exception is permanent erasure of a person, which an owner performs
       * on somebody who is neither themselves nor the founder.
       */
      allow delete: if isOwner() && !isSelf(uid) && !targetIsFounder();
    }

    /* ------------------------------------------------------------------ *
     * registrationRequests — retired
     *
     * People are given accounts by the CEO; nobody signs themselves up. That
     * removed the only public write in the system, so this is now closed
     * outright rather than narrowed.
     *
     * Existing documents are left where they are and become unreadable, which
     * is the same treatment contracts and chat threads got: inert, not
     * destroyed, because deleting somebody's data as a side effect of an
     * upgrade is not a decision a rule change should take.
     * ------------------------------------------------------------------ */

    match /registrationRequests/{uid} {
      allow read, write: if false;
    }

    /* ------------------------------------------------------------------ *
     * employees/{uid} — professional identity
     *
     * Per the specification an employee cannot hide these from coworkers:
     * they describe the job, not the person. What an employee may edit about
     * themselves is limited to the presentational fields listed below —
     * never their role, status, department or position.
     * ------------------------------------------------------------------ */

    match /employees/{uid} {
      /* Own record always; everybody else's only from inside the company. */
      allow read: if isSelf(uid) || (isInternal() && can('employees.view'));

      allow create: if can('employees.create')
        && request.resource.data.uid == uid;

      /*
       * Four distinct ways this document may change, and no others.
       *
       * The founder guard sits at the TOP rather than inside each branch. It
       * was written per-branch first and one path slipped through — a rule
       * that has to be remembered in four places will eventually be forgotten
       * in one. Stated once, it covers every branch here and every branch
       * added later.
       *
       * Note also the second branch: holding edit_professional is NOT enough
       * to change status or roleIds. Editing somebody's job title must never
       * double as a way to change who they are or what they may do.
       */
      allow update: if request.resource.data.uid == resource.data.uid
        /* The founder's record is theirs alone to change. */
        && (isSelf(uid) || !personIsFounder(uid))
        && (
          (
            isSelf(uid)
            && isActive()
            && changedOnly(['photoUrl', 'bio', 'skills', 'expertise', 'updatedAt'])
          )
          || (
            can('employees.edit_professional')
            && (
              request.resource.data.status == resource.data.status
              || can('employees.manage_status')
            )
            && (
              request.resource.data.roleIds == resource.data.roleIds
              || can('roles.assign')
            )
          )
          || (can('employees.manage_status') && changedOnly(['status', 'updatedAt']))
          || (can('roles.assign') && changedOnly(['roleIds', 'updatedAt']))
        );

      /*
       * Permanent erasure. Deliberately narrow.
       *
       * Deactivation is the normal way to remove somebody: it keeps the record
       * and is reversible. This exists for the cases where the data itself has
       * to go, and it is restricted to an owner acting on somebody who is
       * neither themselves nor the founder.
       *
       * The audit trail survives it. Log entries store a snapshot of the name
       * they acted on, so what a deleted person did remains readable after
       * their record is gone.
       */
      allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);

      /* ---------------------------------------------------------------- *
       * Privacy tiers.
       *
       * Firestore guards a document, never a field — so the three visibility
       * levels are three documents. Moving a field between them IS the
       * privacy setting. A mistake in one tier cannot leak the others.
       * ---------------------------------------------------------------- */

      match /visibility/everyone {
        allow read: if isSelf(uid) || (isInternal() && can('employees.view'));
        allow write: if isSelf(uid) || isOwner();
        /* Firestore does not cascade, so erasure has to reach each tier. */
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      match /visibility/management {
        allow read: if isSelf(uid) || (isInternal() && can('employees.view_private_info'));
        allow write: if isSelf(uid) || isOwner();
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      /*
       * The CEO is included because company administration must never be
       * blocked by an employee's privacy choices. No other permission opens
       * this tier.
       */
      match /visibility/private {
        allow read: if isSelf(uid) || isOwner();
        allow write: if isSelf(uid) || isOwner();
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      /* ---------------------------------------------------------------- *
       * CEO notes — never readable by their subject.
       *
       * The !isSelf(uid) clause matters: a manager who holds
       * employee_notes.view must still not read what is written about them.
       * ---------------------------------------------------------------- */

      match /notes/{noteId} {
        allow read: if isOwner() || (can('employee_notes.view') && !isSelf(uid));

        allow create: if can('employee_notes.create')
          && !isSelf(uid)
          && request.resource.data.authorUid == me()
          && request.resource.data.employeeUid == uid;

        allow update: if can('employee_notes.edit')
          && !isSelf(uid)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.employeeUid == resource.data.employeeUid
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if can('employee_notes.delete') && !isSelf(uid);
      }
    }

    /* ------------------------------------------------------------------ *
     * Roles, permission catalogue, departments, positions
     *
     * Readable by any active employee: the directory has to render a role
     * name next to a person. Only the permission list inside a role carries
     * weight, and changing it is gated below.
     * ------------------------------------------------------------------ */

    match /roles/{roleId} {
      allow read: if isInternal();

      allow create: if can('roles.create')
        && (request.resource.data.grantsAll == false || isOwner())
        && request.resource.data.isSystem == false;

      /*
       * What a built-in role protects, and what it does not.
       *
       * This used to allow a system role only a change of name and
       * description — which froze the permission list of every role that
       * exists, because all of them are built in. The CEO could tick
       * permissions on the Employee role, press save, and the database refused
       * it silently. That is the whole of "roles cannot be saved".
       *
       * The freeze protected nothing. `can()` and `isOwner()` read the
       * signed-in user's own access document, never the role, so no edit to a
       * role's permission list can lock anybody out. What must stay fixed is
       * the role's identity — its key, whether it is built in, and whether it
       * grants everything — and `status`, since deactivating the owner role
       * would take it out of circulation for no good reason.
       */
      allow update: if can('roles.edit')
        && request.resource.data.key == resource.data.key
        && request.resource.data.isSystem == resource.data.isSystem
        /*
         * What grants everything is the founder's decision alone.
         *
         * This said `isOwner()`, which let any co-owner flip `grantsAll` on any
         * role — including one already handed out. The escalation stopped one
         * step later, because writing `isCeo: true` onto somebody's access
         * needs `isFounder()`, but a door that only exists to be walked through
         * later is not a door worth leaving open. A rule check found this the
         * first time it was asked the question.
         */
        && (request.resource.data.grantsAll == resource.data.grantsAll || isFounder())
        && (
          resource.data.isSystem == false
          || request.resource.data.status == resource.data.status
        );

      /* Roles are deactivated, never deleted — deleting destroys history. */
      allow delete: if false;
    }

    match /permissions/{key} {
      allow read: if isInternal();
      allow write: if false;
    }

    match /departments/{id} {
      allow read: if isInternal();
      allow write: if can('departments.manage');
    }

    match /positions/{id} {
      allow read: if isInternal();
      allow write: if can('positions.manage');
    }

    /* ------------------------------------------------------------------ *
     * The business side: clients, projects, services, income, expenses
     *
     * All of it is internal. isInternal() comes first on every rule, so an
     * affiliate partner never reaches a client record, a project or a figure,
     * whatever permissions their role happens to carry.
     *
     * Nothing here is deletable by rule. Records that money was attached to
     * are the company's history, and a status is the way to retire one.
     * ------------------------------------------------------------------ */

    /* ------------------------------------------------------------------ *
     * The business records
     *
     * Three ideas run through every rule below. Reading one of them here
     * saves reading it eleven times:
     *
     * 1. ACTIONS ARE SEPARATE. `view`, `create`, `edit`, `delete` are four
     *    permissions, not one. "Can access clients" is not something anybody
     *    can reason about; "may see them, may add one, may not remove one" is.
     *
     * 2. `view` VERSUS `view_all`. Without the wider permission you read only
     *    records you own. The filter is HERE, not in a query — removing it
     *    from the client changes nothing.
     *
     * 3. DELETING DOES NOT DESTROY. A delete is an update that sets
     *    `deletedAt`; every list filters on it and the recycle bin selects on
     *    it. Actually destroying a document needs `recycle_bin.purge`, which
     *    is a different authority given to almost nobody.
     * ------------------------------------------------------------------ */

    /** Does the caller own this record, by any of the fields that mean "mine"? */
    function ownsRecord() {
      return resource.data.get('assigneeUid', '') == me()
        || resource.data.get('ownerUid', '') == me()
        || resource.data.get('responsibleUid', '') == me()
        || resource.data.get('employeeUid', '') == me()
        || resource.data.get('createdBy', '') == me();
    }

    /** Read a record: the wide permission, or the narrow one plus ownership. */
    function canRead(base) {
      return isInternal() && can(base + '.view')
        && (can(base + '.view_all') || ownsRecord());
    }

    /**
     * An edit that only moves a record into or out of the recycle bin.
     *
     * Separated from an ordinary edit so that `delete` and `edit` can be given
     * to different people: a junior may correct a client's phone number
     * without being able to make the client disappear.
     */
    function isBinChange() {
      return changedOnly(['deletedAt', 'deletedBy', 'deletedByName', 'updatedAt']);
    }

    function canDelete(base) {
      return isInternal() && can(base + '.delete');
    }

    function canPurge() {
      return isInternal() && can('recycle_bin.purge');
    }

    /* ---- Clients ---------------------------------------------------- */

    match /clients/{clientId} {
      allow read: if canRead('clients');

      allow create: if isInternal() && can('clients.create')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('clients.delete') || can('recycle_bin.restore')))
          || can('clients.edit')
        );

      /* Destroying one for good is the recycle bin's job, not this rule's. */
      allow delete: if canPurge();

      /*
       * CEO-only commercial terms on a client, kept out of the main document
       * so that reading a client does not reveal what they pay.
       */
      match /terms/{termId} {
        allow read: if isInternal() && can('finance.view');
        allow write: if isInternal() && can('finance.edit');
      }
    }

    /* ---- Leads ------------------------------------------------------- */

    /*
     * The one place an affiliate may write.
     *
     * An outside partner submits a lead through their panel and then watches
     * it. They may create one that names them, read the ones they submitted,
     * and nothing else — the `isInternal()` on every other rule in this file
     * is what makes that true regardless of the permissions they hold.
     */
    match /leads/{leadId} {
      allow read: if canRead('leads')
        || (isAffiliate() && resource.data.get('createdBy', '') == me());

      allow create: if isActive() && can('leads.create')
        && request.resource.data.createdBy == me()
        /* An affiliate cannot submit a lead already assigned to somebody. */
        && (isInternal() || request.resource.data.get('assigneeUid', null) == null);

      allow update: if isInternal()
        && (
          (isBinChange() && (can('leads.delete') || can('recycle_bin.restore')))
          || can('leads.edit')
        );

      allow delete: if canPurge();
    }

    /* ---- Projects ---------------------------------------------------- */

    match /projects/{projectId} {
      /* Being on the team is a form of ownership for reading purposes. */
      allow read: if isInternal() && can('projects.view')
        && (
          can('projects.view_all')
          || ownsRecord()
          || me() in resource.data.get('teamUids', [])
        );

      allow create: if isInternal() && can('projects.create')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('projects.delete') || can('recycle_bin.restore')))
          || can('projects.edit')
        );

      allow delete: if canPurge();
    }

    /* ---- Sales ------------------------------------------------------- */

    match /sales/{saleId} {
      allow read: if canRead('sales');

      allow create: if isInternal() && can('sales.create')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('sales.delete') || can('recycle_bin.restore')))
          || can('sales.edit')
        );

      allow delete: if canPurge();
    }

    /* ---- Services ---------------------------------------------------- */

    match /services/{serviceId} {
      allow read: if isInternal() && can('services.view');

      allow create, update: if isInternal() && can('services.manage');

      allow delete: if canPurge();
    }

    /*
     * What a service costs, and what the company makes on it.
     *
     * A SEPARATE DOCUMENT, and that is the entire point. These rules are
     * document-level: whoever may read a document reads every field on it, so
     * a price stored beside the service name reaches the browser of anybody
     * who can see the service at all — whatever the interface chooses to draw.
     * Hiding it in the UI would be a decoration, not a permission.
     *
     * Splitting it is what makes services.view_price real. Without that
     * permission the read is refused here and the figure never leaves the
     * database.
     */
    match /services/{serviceId}/commercial/{document} {
      allow read: if isInternal() && can('services.view_price');
      allow write: if isInternal() && can('services.manage');
    }

    /* ---- Finance ------------------------------------------------------ */

    /*
     * One collection for every financial record, distinguished by `type`.
     * There is no separate expenses collection any more: a cost and a payment
     * are the same kind of fact pointing in opposite directions, and keeping
     * them apart meant every total had to be assembled twice.
     */
    match /transactions/{txId} {
      allow read: if isInternal() && can('finance.view');

      allow create: if isInternal() && can('finance.create')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('finance.delete') || can('recycle_bin.restore')))
          || can('finance.edit')
        );

      allow delete: if canPurge();
    }

    /* ---- Affiliate programme ------------------------------------------ */

    /*
     * An affiliate may read their own record — their commission rules are
     * their terms — and nothing else in this collection.
     */
    match /affiliates/{affiliateId} {
      allow read: if (isInternal() && can('affiliates.view'))
        || (isActive() && resource.data.get('employeeUid', '') == me());

      allow create, update: if isInternal() && can('affiliates.manage');

      allow delete: if canPurge();
    }

    /*
     * A commission is money owed to somebody, so this is the strictest write
     * rule in the file:
     *
     *   earning it     needs finance.create — it follows a payment
     *   approving it   needs commissions.approve, a separate decision
     *   paying it      needs commissions.approve as well
     *
     * And nobody may approve their own. That is the line worth being explicit
     * about, because an affiliate who is also an employee could otherwise sign
     * off their own payout.
     */
    match /commissions/{commissionId} {
      allow read: if (isInternal() && can('affiliates.view'))
        || (isActive() && resource.data.get('affiliateEmployeeUid', '') == me());

      allow create: if isInternal() && can('finance.create')
        && request.resource.data.status == 'pending';

      allow update: if isInternal()
        && (
          (
            can('commissions.approve')
            && request.resource.data.get('affiliateEmployeeUid', '') != me()
          )
          || (can('affiliates.manage') && changedOnly(['note', 'updatedAt']))
        );

      allow delete: if false;
    }

    /* ---- Goals -------------------------------------------------------- */

    match /goals/{goalId} {
      /*
       * A company goal that only management can see is not a shared goal, so
       * `everyone` is the ordinary case. `owners` narrows it to the people it
       * was set for; `management` needs the wider permission.
       */
      allow read: if isInternal() && can('goals.view')
        && (
          resource.data.get('visibility', 'everyone') == 'everyone'
          || can('goals.manage')
          || me() in resource.data.get('ownerUids', [])
        );

      allow create: if isInternal() && can('goals.manage')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('goals.manage') || can('recycle_bin.restore')))
          || can('goals.manage')
        );

      allow delete: if canPurge();
    }

    /* Which KPIs a role is measured on. */
    match /roleKpis/{roleId} {
      allow read: if isInternal();
      allow write: if isInternal() && can('roles.edit');
    }

    /* ---- Bonuses ------------------------------------------------------- */

    /*
     * A bonus programme is readable by the staff it applies to — a scheme
     * nobody can see motivates nobody — but writable only by whoever runs it.
     * `visibleToStaff` lets one be drafted before it is announced.
     */
    match /bonusPrograms/{programmeId} {
      allow read: if isInternal() && can('bonuses.view')
        && (can('bonuses.manage') || resource.data.get('visibleToStaff', false) == true);

      allow create: if isInternal() && can('bonuses.manage')
        && request.resource.data.createdBy == me();

      allow update: if isInternal()
        && (
          (isBinChange() && (can('bonuses.manage') || can('recycle_bin.restore')))
          || can('bonuses.manage')
        );

      allow delete: if canPurge();
    }

    /*
     * An award is money the company has committed to a person.
     *
     * The employee it belongs to may read it and may not touch it. Creating
     * one needs bonuses.manage; moving it along the status ladder — earned,
     * approved, paid — needs bonuses.approve; and nobody may approve their
     * own, for the same reason as commissions.
     */
    match /bonusAwards/{awardId} {
      allow read: if (isInternal() && can('bonuses.view_all'))
        || (isActive() && resource.data.employeeUid == me());

      allow create: if isInternal() && can('bonuses.manage')
        && request.resource.data.get('employeeUid', '') != me()
        && request.resource.data.status in ['pending', 'earned'];

      allow update: if isInternal()
        && can('bonuses.approve')
        && resource.data.employeeUid != me();

      allow delete: if canPurge();
    }

    /*
     * Extra work with a reward attached.
     *
     * The status ladder is the whole guard. The person doing the work may
     * move it as far as `submitted`; `approved` is what earns the bonus and
     * only somebody else can set it. An employee editing their own row is
     * also refused any change to the reward.
     */
    match /incentiveWork/{workId} {
      allow read: if (isInternal() && can('bonuses.view_all'))
        || (isActive() && resource.data.assigneeUid == me())
        || (isInternal() && resource.data.get('createdBy', '') == me());

      allow create: if isInternal() && can('bonuses.manage')
        && request.resource.data.createdBy == me()
        && request.resource.data.status == 'assigned';

      allow update: if isInternal()
        && (
          /* The manager's side: anything, including approving it. */
          can('bonuses.approve')
          || can('bonuses.manage')
          /* The worker's side: progress and a submission note, nothing else. */
          || (
            resource.data.assigneeUid == me()
            && changedOnly(['status', 'submissionNote', 'submittedAt', 'updatedAt'])
            && request.resource.data.status in ['assigned', 'in_progress', 'submitted']
          )
        );

      allow delete: if canPurge();
    }

    /* ---- Calendar ------------------------------------------------------ */

    match /calendarEvents/{eventId} {
      allow read: if isInternal() && can('calendar.view');

      allow create: if isInternal() && can('calendar.manage')
        && request.resource.data.createdBy == me();

      allow update: if isInternal() && can('calendar.manage')
        && (resource.data.createdBy == me() || isOwner() || isBinChange());

      allow delete: if canPurge();
    }

    /* ---- Notes --------------------------------------------------------- */

    /*
     * Notes replaced the task module. They are attached to a client, a lead, a
     * project or a sale, readable by anybody inside, and editable only by
     * whoever wrote one — a note is somebody's words.
     */
    match /notes/{noteId} {
      allow read: if isInternal();

      allow create: if isInternal() && request.resource.data.authorUid == me();

      allow update: if isInternal()
        && (
          resource.data.authorUid == me()
          /* Anybody may tick off a reminder; only the author may reword it. */
          || changedOnly(['done', 'pinned', 'updatedAt'])
        );

      allow delete: if isInternal()
        && (resource.data.authorUid == me() || isOwner());
    }

    /* ---- Activity ------------------------------------------------------- */

    /*
     * What has been going on with a record, in words, for whoever works on it.
     *
     * Not the audit log. The audit log answers "who changed permissions in
     * March" and is closed to ordinary employees; this answers "what happened
     * with this client" and is meant to be read. Append-only all the same:
     * a history somebody can edit is not a history.
     */
    match /activity/{entryId} {
      allow read: if isInternal();

      allow create: if isActive() && request.resource.data.actorUid == me();

      allow update, delete: if false;
    }

    /* ---- Custom fields --------------------------------------------------- */

    /*
     * Definitions, not values. The values live on the records themselves, so
     * a person who may read a client reads its custom values with it; this
     * collection only describes what the fields are.
     */
    match /customFields/{fieldId} {
      allow read: if isInternal();
      allow write: if isInternal() && can('custom_fields.manage');
    }

    /* ---- Notifications ---------------------------------------------------- */

    /*
     * Stored per person, so isolation is structural: there is no query that
     * reaches somebody else's notifications, whatever permissions the caller
     * holds.
     *
     * KNOWN LIMIT: creation is open to any active account, because assigning a
     * lead has to be able to notify the person it went to and there is no
     * server to do it. The forgeable part is bounded — an entry must name its
     * true author — but a determined employee could send a colleague a
     * notification the application would not have generated. Cloud Functions
     * close this, and the same limit already applies to the audit log.
     */
    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if isSelf(uid);
      allow create: if isActive() && request.resource.data.get('actorUid', me()) == me();
    }

    /* ------------------------------------------------------------------ *
     * walletEntries — what the company owes a person, and why
     *
     * Append-only, and that is the whole design. The balance is never stored;
     * it is the sum of these lines. So an amount, once written, is not
     * writable again — a mistake is corrected by a second entry, which keeps
     * the record of what the company believed it owed even when it was wrong.
     *
     * Three refusals matter here:
     *
     *   nobody adds to their own ledger, whatever else they hold;
     *   nobody reads somebody else's without wallet.view_all;
     *   nothing but the status ever changes, and only with wallet.adjust.
     * ------------------------------------------------------------------ */

    match /walletEntries/{entryId} {
      allow read: if isActive()
        && (resource.data.employeeUid == me() || can('wallet.view_all'));

      allow create: if isInternal()
        && can('wallet.adjust')
        /* The one that matters: never for yourself. */
        && request.resource.data.employeeUid != me()
        && request.resource.data.createdBy == me();

      /*
       * Only the status moves. The amount, the person and the reason are the
       * record; changing them after the fact is exactly what a ledger is for
       * preventing.
       */
      allow update: if isInternal()
        && can('wallet.adjust')
        && resource.data.employeeUid != me()
        && changedOnly(['status', 'approvedBy', 'approvedAt', 'paidAt', 'updatedAt']);

      /* An entry is cancelled, never deleted. */
      allow delete: if false;
    }

    match /notificationPrefs/{uid} {
      allow read, write: if isSelf(uid);
    }

    /*
     * A person's chosen dashboard widgets.
     *
     * Theirs alone, and worth nothing to anybody else. Note what this rule
     * does NOT do: it does not police which widgets are named. It cannot, and
     * it does not need to — every widget reads a collection guarded by its own
     * rule, so a layout naming the finance widgets renders empty for somebody
     * without finance.view. The layout is a preference; the permission is
     * enforced where the data is.
     */
    match /dashboardLayouts/{uid} {
      allow read, write: if isSelf(uid);
    }

    /* ---- Exchange rates ---------------------------------------------------- */

    /*
     * Cached from the national bank so a rate is fetched once per day rather
     * than per record. Readable by anybody inside; written by whoever is
     * recording money at the time.
     */
    match /exchangeRates/{date} {
      allow read: if isInternal();
      allow create: if isInternal() && can('finance.create');
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * auditLogs — append only
     *
     * Entries may be created by any active account but never altered or
     * removed by anyone, and the actor cannot be forged.
     *
     * KNOWN LIMIT: because the client writes these, the rules can reject a
     * forged or tampered entry but cannot force an entry to be written at
     * all. Someone working directly against the API could perform an action
     * and skip logging it. Closing that gap requires Cloud Functions (Blaze
     * plan), which is the intended upgrade path. Everything done through the
     * application itself is logged.
     * ------------------------------------------------------------------ */

    match /auditLogs/{entryId} {
      allow read: if can('audit_log.view');

      allow create: if isActive()
        && request.resource.data.actorUid == me()
        && request.resource.data.actorEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Company settings
     * ------------------------------------------------------------------ */

    match /companySettings/{key} {
      allow read: if isInternal();
      allow write: if can('company_settings.edit');
    }

    /* ------------------------------------------------------------------ *
     * Prepared for StayBrain. Unused in version 1 and locked to the CEO, so
     * an unfinished feature cannot become an opening.
     * ------------------------------------------------------------------ */

    match /externalReferences/{id} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    /*
     * Everything else is denied. Firestore refuses anything not matched
     * above — do not add a catch-all rule here.
     */
  }
}
