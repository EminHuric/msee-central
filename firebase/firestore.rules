rules_version = '2';

/*
 * MsEe Central — Firestore Security Rules
 *
 * THIS FILE IS THE SECURITY BOUNDARY. Everything in src/ that checks a
 * permission does so for the user's convenience: to hide a button, to skip a
 * doomed request. None of it stops anybody. A person with a browser console
 * talks to Firestore directly, and these rules are what answers them.
 *
 * Two habits keep this file trustworthy:
 *
 *   1. Deny by default. Firestore already refuses anything not matched below;
 *      never add a broad `match /{document=**}` to "make it work".
 *   2. Never trust a field the client sent. `request.resource.data` is
 *      attacker-controlled. Compare it against `resource.data` (what is
 *      already stored) or against the caller's own permission document.
 *
 * The tests in tests/rules prove the important claims. Run them after every
 * change to this file:  npm run rules:test
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Identity helpers
     * ------------------------------------------------------------------ */

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    /*
     * userPermissions/{uid} is the single source of truth for authority.
     * Its ABSENCE is meaningful: an account that has registered but has not
     * been approved has no such document, and therefore no access at all.
     */
    function accessPath() {
      return /databases/$(database)/documents/userPermissions/$(request.auth.uid);
    }

    function hasAccess() {
      return signedIn() && exists(accessPath());
    }

    function access() {
      return get(accessPath()).data;
    }

    /* Suspended, deactivated and rejected accounts fail here and read nothing. */
    function isActive() {
      return hasAccess() && access().status == 'active';
    }

    /*
     * An OWNER: CEO or CTO. Both carry a role marked grantsAll and are equal in
     * every power the system has.
     *
     * The stored field is still called isCeo because that is what exists in the
     * database; read it as "owner". Owner status is what opens the private
     * privacy tier, CEO notes and the ability to appoint another owner.
     *
     * The safety rail that makes two owners meaningful: nobody may remove their
     * own owner role, so an owner can only ever be removed by the other one.
     */
    function isOwner() {
      return isActive() && access().isCeo == true;
    }

    /*
     * The FOUNDER — the person who owns the company.
     *
     * One account, marked once by tools/setup-ceo.mjs and never grantable from
     * inside the application: every rule below refuses to write the flag, so
     * it cannot be forged or handed around.
     *
     * It buys two things nothing else can:
     *   - the founder's account cannot be altered by anybody, owner or not;
     *   - only the founder may appoint or remove a co-owner.
     *
     * `.get('isFounder', false)` rather than a plain field read, so documents
     * written before this flag existed evaluate to false instead of erroring.
     */
    function isFounder() {
      return isActive() && access().get('isFounder', false) == true;
    }

    /** Is the document being written the founder's own? */
    function targetIsFounder() {
      return resource != null && resource.data.get('isFounder', false) == true;
    }

    /**
     * Same question asked about a person rather than a document, for rules
     * outside the userPermissions collection.
     */
    function personIsFounder(uid) {
      return exists(/databases/$(database)/documents/userPermissions/$(uid))
        && get(/databases/$(database)/documents/userPermissions/$(uid))
             .data.get('isFounder', false) == true;
    }

    /*
     * An AFFILIATE — an outside partner, not staff.
     *
     * They bring business and earn commission. They hold a real account and a
     * real login, and none of that makes them part of the company: they see
     * their own figures and nothing else. No colleagues, no departments, no
     * roles catalogue, no company settings.
     *
     * Checked here rather than left to permissions, because a permission can
     * be granted by mistake and this line should not be crossable by mistake.
     * Every internal read below asks isInternal() first, so an affiliate
     * holding employees.view still sees nobody.
     *
     * Defaults to 'employee' so accounts written before this existed keep
     * working as staff.
     */
    function isAffiliate() {
      return isActive() && access().get('accountType', 'employee') == 'affiliate';
    }

    /** Inside the company: staff, whatever their role. */
    function isInternal() {
      return isActive() && !isAffiliate();
    }

    /*
     * The CEO role carries grantsAll, so it answers true for permissions that
     * do not exist yet. Future modules are covered without touching this file.
     */
    function can(permission) {
      return isActive() && (access().isCeo == true || permission in access().permissions);
    }

    /* Only these keys differ between the stored document and the incoming one. */
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    /* ------------------------------------------------------------------ *
     * userPermissions — the crown jewel
     *
     * Three tiers of authority, and each is protected from the one below it:
     *
     *   founder   the company owner. Untouchable by anyone. Only they may
     *             appoint or remove a co-owner.
     *   owner     CEO or a co-owner. Full authority over everybody except the
     *             founder, and cannot create another owner.
     *   manager   holds roles.assign. May configure ordinary employees, and
     *             may never write their OWN document — that is what stops an
     *             employee promoting themselves.
     *
     * The founder document is created by tools/setup-ceo.mjs through the Admin
     * SDK, which bypasses these rules. That is deliberate: there is no
     * bootstrap path here for anyone to climb through, and equally no recovery
     * path if the founder account is lost. The service account key is the only
     * way back, which is why it matters as much as the password.
     * ------------------------------------------------------------------ */

    match /userPermissions/{uid} {
      allow read: if isSelf(uid) || can('roles.assign');

      allow create: if request.resource.data.uid == uid
        && can('roles.assign')
        && !isSelf(uid)
        /* The founder mark is never granted from inside the application. */
        && request.resource.data.get('isFounder', false) == false
        /* Only the founder may appoint a co-owner. */
        && (request.resource.data.isCeo == false || isFounder());

      allow update: if request.resource.data.uid == uid
        && (
          /*
           * Someone else's document.
           *
           * Three separate refusals here, and each closes a different door:
           * a manager cannot touch their own; nobody at all can touch the
           * founder's; and only the founder can hand out owner status.
           */
          (
            can('roles.assign')
            && !isSelf(uid)
            && !targetIsFounder()
            && request.resource.data.get('isFounder', false) == false
            && (request.resource.data.isCeo == false || isFounder())
          )
          /*
           * An owner editing their own document. Allowed because an owner
           * already holds every permission — there is nothing here to escalate
           * to — and scoped to isOwner() so the branch above keeps protecting
           * everyone below.
           *
           * The three conditions stop an owner locking themselves out: they
           * cannot drop their own owner status, cannot set themselves to
           * anything but active, and cannot change their founder mark in
           * either direction.
           */
          || (
            isOwner()
            && isSelf(uid)
            && request.resource.data.isCeo == true
            && request.resource.data.status == 'active'
            && request.resource.data.get('isFounder', false)
               == resource.data.get('isFounder', false)
          )
        );

      /*
       * Access is revoked by setting status, never by deleting. The one
       * exception is permanent erasure of a person, which an owner performs
       * on somebody who is neither themselves nor the founder.
       */
      allow delete: if isOwner() && !isSelf(uid) && !targetIsFounder();
    }

    /* ------------------------------------------------------------------ *
     * registrationRequests
     *
     * Written once by the applicant, thereafter only by a reviewer. The
     * applicant cannot approve themselves because they cannot update at all.
     * ------------------------------------------------------------------ */

    match /registrationRequests/{uid} {
      allow read: if isSelf(uid) || can('registration_requests.view');

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewedBy == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.rejectionReason == null
        && request.resource.data.email == request.auth.token.email;

      allow update: if (can('registration_requests.approve') || can('registration_requests.reject'))
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.submittedAt == resource.data.submittedAt;

      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * employees/{uid} — professional identity
     *
     * Per the specification an employee cannot hide these from coworkers:
     * they describe the job, not the person. What an employee may edit about
     * themselves is limited to the presentational fields listed below —
     * never their role, status, department or position.
     * ------------------------------------------------------------------ */

    match /employees/{uid} {
      /* Own record always; everybody else's only from inside the company. */
      allow read: if isSelf(uid) || (isInternal() && can('employees.view'));

      allow create: if can('registration_requests.approve')
        && request.resource.data.uid == uid;

      /*
       * Four distinct ways this document may change, and no others.
       *
       * The founder guard sits at the TOP rather than inside each branch. It
       * was written per-branch first and one path slipped through — a rule
       * that has to be remembered in four places will eventually be forgotten
       * in one. Stated once, it covers every branch here and every branch
       * added later.
       *
       * Note also the second branch: holding edit_professional is NOT enough
       * to change status or roleIds. Editing somebody's job title must never
       * double as a way to change who they are or what they may do.
       */
      allow update: if request.resource.data.uid == resource.data.uid
        /* The founder's record is theirs alone to change. */
        && (isSelf(uid) || !personIsFounder(uid))
        && (
          (
            isSelf(uid)
            && isActive()
            && changedOnly(['photoUrl', 'bio', 'skills', 'expertise', 'updatedAt'])
          )
          || (
            can('employees.edit_professional')
            && (
              request.resource.data.status == resource.data.status
              || can('employees.manage_status')
            )
            && (
              request.resource.data.roleIds == resource.data.roleIds
              || can('roles.assign')
            )
          )
          || (can('employees.manage_status') && changedOnly(['status', 'updatedAt']))
          || (can('roles.assign') && changedOnly(['roleIds', 'updatedAt']))
        );

      /*
       * Permanent erasure. Deliberately narrow.
       *
       * Deactivation is the normal way to remove somebody: it keeps the record
       * and is reversible. This exists for the cases where the data itself has
       * to go, and it is restricted to an owner acting on somebody who is
       * neither themselves nor the founder.
       *
       * The audit trail survives it. Log entries store a snapshot of the name
       * they acted on, so what a deleted person did remains readable after
       * their record is gone.
       */
      allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);

      /* ---------------------------------------------------------------- *
       * Privacy tiers.
       *
       * Firestore guards a document, never a field — so the three visibility
       * levels are three documents. Moving a field between them IS the
       * privacy setting. A mistake in one tier cannot leak the others.
       * ---------------------------------------------------------------- */

      match /visibility/everyone {
        allow read: if isSelf(uid) || (isInternal() && can('employees.view'));
        allow write: if isSelf(uid) || isOwner();
        /* Firestore does not cascade, so erasure has to reach each tier. */
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      match /visibility/management {
        allow read: if isSelf(uid) || (isInternal() && can('employees.view_private_info'));
        allow write: if isSelf(uid) || isOwner();
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      /*
       * The CEO is included because company administration must never be
       * blocked by an employee's privacy choices. No other permission opens
       * this tier.
       */
      match /visibility/private {
        allow read: if isSelf(uid) || isOwner();
        allow write: if isSelf(uid) || isOwner();
        allow delete: if isOwner() && !isSelf(uid) && !personIsFounder(uid);
      }

      /* ---------------------------------------------------------------- *
       * CEO notes — never readable by their subject.
       *
       * The !isSelf(uid) clause matters: a manager who holds
       * employee_notes.view must still not read what is written about them.
       * ---------------------------------------------------------------- */

      match /notes/{noteId} {
        allow read: if isOwner() || (can('employee_notes.view') && !isSelf(uid));

        allow create: if can('employee_notes.create')
          && !isSelf(uid)
          && request.resource.data.authorUid == me()
          && request.resource.data.employeeUid == uid;

        allow update: if can('employee_notes.edit')
          && !isSelf(uid)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.employeeUid == resource.data.employeeUid
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if can('employee_notes.delete') && !isSelf(uid);
      }
    }

    /* ------------------------------------------------------------------ *
     * Roles, permission catalogue, departments, positions
     *
     * Readable by any active employee: the directory has to render a role
     * name next to a person. Only the permission list inside a role carries
     * weight, and changing it is gated below.
     * ------------------------------------------------------------------ */

    match /roles/{roleId} {
      allow read: if isInternal();

      allow create: if can('roles.create')
        && (request.resource.data.grantsAll == false || isOwner())
        && request.resource.data.isSystem == false;

      allow update: if can('roles.edit')
        && request.resource.data.key == resource.data.key
        && request.resource.data.isSystem == resource.data.isSystem
        && (request.resource.data.grantsAll == resource.data.grantsAll || isOwner())
        && (
          resource.data.isSystem == false
          || changedOnly(['name', 'nameSr', 'description', 'descriptionSr', 'updatedAt'])
        );

      /* Roles are deactivated, never deleted — deleting destroys history. */
      allow delete: if false;
    }

    match /permissions/{key} {
      allow read: if isInternal();
      allow write: if false;
    }

    match /departments/{id} {
      allow read: if isInternal();
      allow write: if can('departments.manage');
    }

    match /positions/{id} {
      allow read: if isInternal();
      allow write: if can('positions.manage');
    }

    /* ------------------------------------------------------------------ *
     * The business side: clients, projects, services, income, expenses
     *
     * All of it is internal. isInternal() comes first on every rule, so an
     * affiliate partner never reaches a client record, a project or a figure,
     * whatever permissions their role happens to carry.
     *
     * Nothing here is deletable by rule. Records that money was attached to
     * are the company's history, and a status is the way to retire one.
     * ------------------------------------------------------------------ */

    /*
     * Collection group over every client's ledger.
     *
     * The Clients page shows one table of all work across all clients, which
     * is a query spanning subcollections rather than a read inside one. That
     * needs its own rule: a nested match only covers a path that already names
     * its client, never a query across them.
     *
     * Same permission as the per-client ledger, so this opens nothing extra.
     */
    match /{path=**}/work/{itemId} {
      allow read: if isInternal() && can('finance.view');
    }

    match /clients/{clientId} {
      allow read: if isInternal() && can('clients.view');
      allow create, update: if isInternal() && can('clients.manage');

      /*
       * Archived rather than deleted. A client with work and invoices behind
       * them is the company's own history, and removing the record would
       * leave every figure pointing at a name nobody can look up.
       */
      allow delete: if false;

      /*
       * The relationship: what they use, what was said, what we noticed.
       * Guarded by clients.manage — an account manager runs this without
       * needing to see the margin.
       */
      match /services/{serviceId} {
        allow read: if isInternal() && can('clients.view');
        allow write: if isInternal() && can('clients.manage');
      }

      match /activities/{activityId} {
        allow read: if isInternal() && can('clients.view');
        allow write: if isInternal() && can('clients.manage');
      }

      match /notes/{noteId} {
        allow read: if isInternal() && can('clients.view');
        allow write: if isInternal() && can('clients.manage');
      }

      /*
       * The money: what was earned, what it cost, what is still owed.
       * Behind finance permissions rather than clients.manage, so the two can
       * be handed to different people.
       *
       * These ARE deletable, unlike the client itself. A mistyped line in a
       * ledger should be removable; a client with history should not.
       */
      match /work/{itemId} {
        allow read: if isInternal() && can('finance.view');
        allow write: if isInternal() && can('finance.manage');
      }

      match /instalments/{instalmentId} {
        allow read: if isInternal() && can('finance.view');
        allow write: if isInternal() && can('finance.manage');
      }

      match /offers/{offerId} {
        allow read: if isInternal() && can('finance.view');
        allow write: if isInternal() && can('finance.manage');
      }
    }

    match /projects/{projectId} {
      allow read: if isInternal() && can('projects.view');
      allow create, update: if isInternal() && can('projects.manage');
      allow delete: if false;
    }

    match /services/{serviceId} {
      allow read: if isInternal() && can('services.view');
      allow create, update: if isInternal() && can('services.manage');
      allow delete: if false;
    }

    /*
     * Overheads only.
     *
     * Money earned from a client lives in that client's ledger, where one row
     * carries both what it cost and what it brought in. This collection is for
     * the costs that belong to nobody in particular — tools, salaries, rent.
     *
     * There was a matching `income` collection and it has been removed. Two
     * places to write the same fact is two places for them to disagree.
     */
    match /expenses/{entryId} {
      allow read: if isInternal() && can('finance.view');
      allow write: if isInternal() && can('finance.manage');
    }

    match /leads/{leadId} {
      allow read: if isInternal() && can('leads.view') && (can('leads.view_all') || ownsRecord());
      allow create: if isInternal() && can('leads.manage')
        && request.resource.data.createdBy == me();
      allow update: if isInternal() && can('leads.manage');
      allow delete: if isInternal() && can('leads.manage') && isOwner();
    }

    /*
     * Tasks are readable by any employee: knowing what the team is working on
     * is not privileged. Creating and assigning needs the projects permission.
     */
    match /tasks/{taskId} {
      allow read: if isInternal();

      allow create: if isInternal() && request.resource.data.createdBy == me();

      /*
       * You may always finish your own work. Editing somebody else's task —
       * reassigning it, moving its deadline — is a manager's act.
       */
      allow update: if isInternal()
        && (
          resource.data.get('assigneeUid', '') == me()
          || resource.data.get('createdBy', '') == me()
          || can('tasks.manage')
        );

      allow delete: if isInternal()
        && (resource.data.get('createdBy', '') == me() || can('tasks.manage'));

      match /comments/{commentId} {
        allow read: if isInternal();
        allow create: if isInternal() && request.resource.data.authorUid == me();
        allow update: if isInternal() && resource.data.authorUid == me()
          && changedOnly(['body', 'editedAt']);
        allow delete: if isInternal()
          && (resource.data.authorUid == me() || can('tasks.manage'));
      }
    }

    /*
     * Exchange rates, cached from the national bank so a rate is fetched once
     * per day rather than per record. Readable by anybody inside; written by
     * whoever is recording money at the time.
     */
    match /exchangeRates/{date} {
      allow read: if isInternal();
      allow create: if isInternal() && can('finance.manage');
      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Sales pipeline
     *
     * `leads.view_all` and `sales.view_all` are the difference between a
     * salesperson and their manager. Without them you read only records you
     * own, and the filter is HERE rather than in the query, so removing it
     * from the client changes nothing.
     * ------------------------------------------------------------------ */

    function ownsRecord() {
      return resource.data.get('assigneeUid', '') == me()
        || resource.data.get('ownerUid', '') == me()
        || resource.data.get('createdBy', '') == me();
    }

    match /sales/{saleId} {
      allow read: if isInternal() && can('sales.view') && (can('sales.view_all') || ownsRecord());
      allow create: if isInternal() && can('sales.manage')
        && request.resource.data.createdBy == me();
      allow update: if isInternal() && can('sales.manage');
      allow delete: if isInternal() && can('sales.manage') && isOwner();
    }

    /* ------------------------------------------------------------------ *
     * Contracts — what was agreed
     *
     * Separate from finance on purpose. A contract says what was promised; an
     * invoice says what was asked for; a payment says what arrived. Reading
     * one of them as another is how a company loses track of what it is owed.
     * ------------------------------------------------------------------ */

    match /contracts/{contractId} {
      allow read: if isInternal() && can('contracts.view');
      allow create, update: if isInternal() && can('contracts.manage');
      /* A contract is history. Cancel it; do not erase it. */
      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Invoices and payments
     * ------------------------------------------------------------------ */

    match /invoices/{invoiceId} {
      allow read: if isInternal() && can('finance.view');
      allow create, update: if isInternal() && can('finance.manage');
      allow delete: if false;
    }

    /*
     * Payments are the record of money that actually moved. They are never
     * edited away: a mistake is corrected with a refund entry, which is why
     * `transfer` and `refund` exist as transaction types.
     */
    match /payments/{paymentId} {
      allow read: if isInternal() && can('finance.view');
      allow create, update: if isInternal() && can('finance.manage');
      allow delete: if isInternal() && can('finance.manage') && isOwner();
    }

    /* ------------------------------------------------------------------ *
     * Affiliate programme
     *
     * An affiliate is an outsider with a login. They may read their OWN
     * record and their own commissions and nothing else — the isolation is in
     * these two rules, not in what the interface chooses to render.
     * ------------------------------------------------------------------ */

    match /affiliates/{affiliateId} {
      allow read: if (isInternal() && can('affiliates.view'))
        || (isActive() && resource.data.get('employeeUid', '') == me());
      allow create, update: if isInternal() && can('affiliates.manage');
      allow delete: if false;
    }

    /*
     * A commission is money owed to somebody, so the write rules are stricter
     * than anywhere else in the system:
     *
     *   earning it     needs finance.manage — it is generated from a payment
     *   approving it   needs commissions.approve, a separate decision
     *   paying it      needs commissions.approve as well
     *
     * Nobody may approve their own. That is the one line worth being explicit
     * about, because an affiliate who is also an employee could otherwise sign
     * off their own payout.
     */
    match /commissions/{commissionId} {
      allow read: if (isInternal() && can('affiliates.view'))
        || (isActive() && resource.data.get('affiliateEmployeeUid', '') == me());

      allow create: if isInternal() && can('finance.manage')
        && request.resource.data.status == 'pending';

      allow update: if isInternal()
        && (
          /* Changing the status is an approval decision. */
          (
            can('commissions.approve')
            && request.resource.data.get('affiliateEmployeeUid', '') != me()
          )
          /* Anything that is not the status is ordinary maintenance. */
          || (can('affiliates.manage') && changedOnly(['note', 'updatedAt']))
        );

      allow delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Goals and KPIs
     *
     * Readable by every employee: a company goal that only management can see
     * is not a shared goal. Progress is computed from live records, so there
     * is nothing here for anybody to inflate.
     * ------------------------------------------------------------------ */

    match /goals/{goalId} {
      allow read: if isInternal() && can('goals.view');
      allow create, update: if isInternal() && can('goals.manage');
      allow delete: if isInternal() && can('goals.manage');
    }

    /* Which KPIs a role is measured on. Configured by whoever edits roles. */
    match /roleKpis/{roleId} {
      allow read: if isInternal();
      allow write: if isInternal() && can('roles.edit');
    }

    /* ------------------------------------------------------------------ *
     * Calendar
     *
     * Only typed-in entries live here. Deadlines, renewals and payment dates
     * are read from the records that own them, so there is no second copy to
     * fall out of step.
     * ------------------------------------------------------------------ */

    match /calendarEvents/{eventId} {
      allow read: if isInternal() && can('calendar.view');
      allow create: if isInternal() && can('calendar.manage')
        && request.resource.data.createdBy == me();
      allow update, delete: if isInternal() && can('calendar.manage')
        && (resource.data.createdBy == me() || isOwner());
    }

    /* ------------------------------------------------------------------ *
     * Notifications
     *
     * Stored per person, so isolation is structural: there is no query that
     * reaches somebody else's notifications, whatever permissions the caller
     * holds.
     *
     * KNOWN LIMIT: creation is open to any active employee, because assigning
     * a task has to be able to notify the person it was assigned to and there
     * is no server to do it. The forgeable part is bounded — an entry must
     * name its true author — but a determined employee could send a colleague
     * a notification the application would not have generated. Cloud Functions
     * close this, and are the intended upgrade; the same limit already applies
     * to the audit log and is documented there.
     * ------------------------------------------------------------------ */

    match /notifications/{uid}/items/{itemId} {
      allow read, update, delete: if isSelf(uid);
      allow create: if isActive() && request.resource.data.get('actorUid', me()) == me();
    }

    match /notificationPrefs/{uid} {
      allow read, write: if isSelf(uid);
    }

    /* ------------------------------------------------------------------ *
     * Internal messages
     *
     * Membership is the whole access rule. A thread lists everybody who may
     * read it, and nobody may add themselves: an update that changes the
     * member list is refused unless the caller already holds chat.manage_groups.
     * ------------------------------------------------------------------ */

    function threadMembers(threadId) {
      return get(/databases/$(database)/documents/chatThreads/$(threadId)).data.memberUids;
    }

    match /chatThreads/{threadId} {
      allow read: if isInternal() && me() in resource.data.memberUids;

      allow create: if isInternal() && can('chat.use')
        && request.resource.data.createdBy == me()
        && me() in request.resource.data.memberUids;

      /*
       * Members may keep the thread current — post a message, mark it read.
       * Changing who is in it is a different act and needs the permission.
       */
      allow update: if isInternal()
        && me() in resource.data.memberUids
        && (
          changedOnly(['lastMessage', 'lastMessageAt', 'lastMessageBy', 'readAt', 'updatedAt'])
          || can('chat.manage_groups')
        );

      allow delete: if isInternal() && can('chat.manage_groups');

      match /messages/{messageId} {
        allow read: if isInternal() && me() in threadMembers(threadId);

        allow create: if isInternal()
          && me() in threadMembers(threadId)
          && request.resource.data.authorUid == me();

        /* Your own words, and only the words. */
        allow update: if isInternal()
          && resource.data.authorUid == me()
          && changedOnly(['body', 'editedAt']);

        allow delete: if isInternal()
          && (resource.data.authorUid == me() || can('chat.manage_groups'));
      }
    }

    /* ------------------------------------------------------------------ *
     * Referral clicks
     *
     * The one collection anybody may write to without an account, because a
     * referral link has to work for a stranger. It is deliberately the
     * narrowest possible opening:
     *
     *   - create only. Nothing here can be read back, changed or deleted by
     *     the person who wrote it, so it cannot be used as storage.
     *   - the document must be exactly {code, at} and nothing else, so it
     *     cannot carry a payload.
     *   - a click earns nobody anything. Commission follows a payment that
     *     arrived, which is why this counter can afford to be public: the
     *     worst an abuser achieves is inflating a vanity number.
     *
     * Affiliate names, contact details and commission rules stay private —
     * the public page never reads this collection or the affiliates one.
     * ------------------------------------------------------------------ */

    match /referralClicks/{clickId} {
      allow read: if isInternal() && can('affiliates.view');

      allow create: if request.resource.data.keys().hasOnly(['code', 'at'])
        && request.resource.data.code is string
        && request.resource.data.code.size() > 0
        && request.resource.data.code.size() <= 40
        && request.resource.data.at is string;

      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * auditLogs — append only
     *
     * Entries may be created by any active account but never altered or
     * removed by anyone, and the actor cannot be forged.
     *
     * KNOWN LIMIT: because the client writes these, the rules can reject a
     * forged or tampered entry but cannot force an entry to be written at
     * all. Someone working directly against the API could perform an action
     * and skip logging it. Closing that gap requires Cloud Functions (Blaze
     * plan), which is the intended upgrade path. Everything done through the
     * application itself is logged.
     * ------------------------------------------------------------------ */

    match /auditLogs/{entryId} {
      allow read: if can('audit_log.view');

      allow create: if isActive()
        && request.resource.data.actorUid == me()
        && request.resource.data.actorEmail == request.auth.token.email;

      allow update, delete: if false;
    }

    /* ------------------------------------------------------------------ *
     * Company settings
     * ------------------------------------------------------------------ */

    match /companySettings/{key} {
      allow read: if isInternal();
      allow write: if can('company_settings.edit');
    }

    /* ------------------------------------------------------------------ *
     * Prepared for StayBrain. Unused in version 1 and locked to the CEO, so
     * an unfinished feature cannot become an opening.
     * ------------------------------------------------------------------ */

    match /externalReferences/{id} {
      allow read: if isOwner();
      allow write: if isOwner();
    }

    /*
     * Everything else is denied. Firestore refuses anything not matched
     * above — do not add a catch-all rule here.
     */
  }
}
