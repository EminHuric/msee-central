# MsEe Central — Firebase web configuration for production builds.
#
# WHY THIS FILE IS COMMITTED, WHEN .env IS NOT
#
# Every value here is public by design. Vite inlines them into the JavaScript
# bundle, so the moment the site is deployed they are readable by anyone who
# opens developer tools. Keeping them out of the repository would hide nothing
# and only make deployment fragile.
#
# What protects the data is firebase/firestore.rules, enforced by Google on
# every read and write. Run `npm run rules:verify` to see that proven: a real
# account with these exact keys still cannot read CEO notes or promote itself.
#
# The genuine secret is tools/serviceAccount.json. It bypasses every rule, it
# is gitignored, and it must never appear in this file or anywhere under src/.

VITE_FIREBASE_API_KEY=AIzaSyDhvSg9W5IK1JAU8-R96AoQFYxmvXy7Q-0
VITE_FIREBASE_AUTH_DOMAIN=msee-central.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=msee-central
VITE_FIREBASE_STORAGE_BUCKET=msee-central.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=124678709002
VITE_FIREBASE_APP_ID=1:124678709002:web:7ea8941526b959fa1824f3

VITE_USE_FIREBASE_EMULATOR=false
