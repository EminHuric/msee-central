# MsEe Central — Firebase web configuration
#
# Copy this file to `.env` and fill in the values from:
#   Firebase Console → Project settings → General → Your apps → SDK setup and configuration
#
# These values are PUBLIC. They ship inside the browser bundle and that is normal
# and expected for Firebase. Data is protected by Firestore Security Rules
# (firebase/firestore.rules), never by hiding these keys.
#
# NEVER put a service account key in this file. That one is a real secret and
# belongs only in tools/serviceAccount.json, which is gitignored.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to run against the local Firebase emulator suite.
VITE_USE_FIREBASE_EMULATOR=false

# ---- The RMS (StayBrain) ----------------------------------------------------
#
# The reservation system StayBrain reads and books into. It is a SEPARATE
# Firebase project, so it needs its own web config — also public, also shipped
# in the bundle, also protected by that project's own security rules.
#
# Leave these empty: src/lib/rms.ts has the real project built in, because a
# connection that silently fails until six variables are set looks broken. Fill
# them only to point StayBrain at a different project, e.g. a test one.
#
# The agency account's PASSWORD is not here and must never be. Somebody signs in
# once from the StayBrain screen and Firebase keeps the session in the browser.
VITE_RMS_API_KEY=
VITE_RMS_AUTH_DOMAIN=
VITE_RMS_PROJECT_ID=
VITE_RMS_STORAGE_BUCKET=
VITE_RMS_MESSAGING_SENDER_ID=
VITE_RMS_APP_ID=
